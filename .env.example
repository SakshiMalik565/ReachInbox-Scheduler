# ==============================================================================
# REACHINBOX EMAIL SCHEDULER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and customize for your environment:
#   cp .env.example .env

# Server & Application
NODE_ENV=development
API_PORT=4000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/reachinbox_scheduler?schema=public

# Redis (Queue and Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch (Email Search Indexing)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Google OAuth 2.0 / OpenID Connect
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Session & Security
# Generate a strong 32+ character random string
SESSION_SECRET=super_secure_random_session_secret_at_least_32_characters_long_for_security

# Slack OAuth 2.0 (Live Notifications)
# Obtain from https://api.slack.com/apps -> OAuth & Permissions
# Redirect URL: http://localhost:4000/api/slack/callback
# Required Bot Scopes: chat:write, channels:read, incoming-webhook
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_CALLBACK_URL=http://localhost:4000/api/slack/callback

# Token Encryption Key
# 32-byte hex string (64 characters) used for AES-256-GCM encryption of sensitive tokens (Slack tokens, SMTP passwords)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Ethereal Email SMTP Credentials
# Create a test account at https://ethereal.email/create or leave blank for automatic test account generation
ETHEREAL_SMTP_HOST=smtp.ethereal.email
ETHEREAL_SMTP_PORT=587
ETHEREAL_SMTP_USER=
ETHEREAL_SMTP_PASS=

# Worker & Scheduling Tuning
# Maximum concurrent jobs per worker process
WORKER_CONCURRENCY=5
# Minimum enforced delay in milliseconds between emails from the same sender
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Maximum emails per hour allowed per sender before deferral to next hour window
MAX_EMAILS_PER_HOUR_PER_SENDER=100
